@{
    ViewData["Title"] = "Category Management";
}
<div class="container mt-4">
    <h2>Category Management</h2>
    <p class="text-muted">Add and configure categories for your events.</p>

    <div class="card shadow-sm p-4 w-50 mb-4">
        <form method="post">
            <div class="mb-3">
                <label class="form-label">New Category Name</label>
                <input type="text" class="form-control" placeholder="e.g., 10km Trail" />
            </div>
            <button type="submit" class="btn btn-success">Add Category</button>
        </form>
    </div>
</div>