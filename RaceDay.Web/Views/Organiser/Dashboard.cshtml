@{
    ViewData["Title"] = "Organiser Dashboard";
}
<div class="container mt-4">
    <h2>Organiser Dashboard</h2>
    <p class="text-muted">Overview of your events, total participants, and quick summaries.</p>

    <div class="row mt-4">
        <div class="col-md-4">
            <div class="card text-white bg-primary mb-3 shadow-sm">
                <div class="card-body">
                    <h5 class="card-title">Total Events</h5>
                    <h3>5</h3>
                </div>
            </div>
        </div>
        <div class="col-md-4">
            <div class="card text-white bg-success mb-3 shadow-sm">
                <div class="card-body">
                    <h5 class="card-title">Active Enrolments</h5>
                    <h3>120</h3>
                </div>
            </div>
        </div>
    </div>
</div>