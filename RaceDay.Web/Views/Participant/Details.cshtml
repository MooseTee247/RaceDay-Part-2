@{
    ViewData["Title"] = "Event Details";
}
<div class="container mt-4">
    <h2>Event Details & Enrolment</h2>
    <p class="text-muted">Select your category and submit your enrolment.</p>

    <div class="card shadow-sm p-4">
        <h4>Spring City Marathon</h4>
        <p><strong>Date:</strong> 2026-06-15</p>
        <p><strong>Description:</strong> Annual city race event.</p>
        
        <form method="post" action="">
            <div class="mb-3">
                <label for="categorySelect" class="form-label">Select Category:</label>
                <select id="categorySelect" class="form-select w-50">
                    <option value="5km">5km Fun Run</option>
                    <option value="21km">21km Half Marathon</option>
                </select>
            </div>
            <button type="submit" class="btn btn-success">Confirm Enrolment</button>
        </form>
    </div>
</div>