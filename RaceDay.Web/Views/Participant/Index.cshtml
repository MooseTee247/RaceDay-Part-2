@{
    ViewData["Title"] = "Browse Events";
}
<div class="container mt-4">
    <h2>Browse & Filter Events</h2>
    <p class="text-muted">Explore upcoming races and filter by category.</p>
    
    <div class="mb-3">
        <label for="categoryFilter" class="form-label">Filter by Category:</label>
        <select id="categoryFilter" class="form-select w-25">
            <option value="">All Categories</option>
            <option value="5km">5km Road Race</option>
            <option value="10km">10km Run</option>
            <option value="Marathon">Marathon</option>
        </select>
    </div>

    <div class="row">
        <div class="col-md-4 mb-3">
            <div class="card shadow-sm">
                <div class="card-body">
                    <h5 class="card-title">Spring City Marathon</h5>
                    <p class="card-text">Category: Marathon</p>
                    <a href="/Participant/Details/1" class="btn btn-primary btn-sm">View Details & Enrol</a>
                </div>
            </div>
        </div>
    </div>
</div>